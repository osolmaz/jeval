{
	"name": "@osolmaz/switch",
	"version": "0.1.0",
	"private": true,
	"description": "A harness that lets decision models work through multi-step tasks by choosing from steps that code lists.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "pnpm@10.20.0",
	"exports": {
		".": {
			"switch-source": "./src/core/index.ts",
			"types": "./dist/src/core/index.d.ts",
			"default": "./dist/src/core/index.js"
		},
		"./cli": {
			"switch-source": "./src/cli/index.ts",
			"types": "./dist/src/cli/index.d.ts",
			"default": "./dist/src/cli/index.js"
		},
		"./models": {
			"switch-source": "./src/models/pi-ai.ts",
			"types": "./dist/src/models/pi-ai.d.ts",
			"default": "./dist/src/models/pi-ai.js"
		},
		"./viewer": {
			"switch-source": "./src/view/index.ts",
			"types": "./dist/src/view/index.d.ts",
			"default": "./dist/src/view/index.js"
		},
		"./page": {
			"switch-source": "./src/view/web/index.ts",
			"types": "./dist/src/view/web/index.d.ts",
			"default": "./dist/src/view/web/index.js"
		},
		"./testing": {
			"switch-source": "./src/testing/index.ts",
			"types": "./dist/src/testing/index.d.ts",
			"default": "./dist/src/testing/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dry": "slophammer-ts dry .",
		"slophammer": "slophammer-ts check .",
		"mutate": "stryker run",
		"examples": "pnpm --filter './examples/*' run check",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm coverage && pnpm dry && pnpm examples && pnpm slophammer"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"commander": "15.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/typescript-checker": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@types/node": "22.19.1",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"happy-dom": "21.0.1",
		"prettier": "3.9.10",
		"slophammer-ts": "0.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	}
}
