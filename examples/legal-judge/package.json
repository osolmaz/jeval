{
	"name": "@switch-examples/legal-judge",
	"version": "0.1.0",
	"private": true,
	"description": "An example harness on switch: a decision model grades a saved answer to a legal task against its rubric.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --check .",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dry": "slophammer-ts dry .",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm coverage && pnpm dry"
	},
	"dependencies": {
		"@osolmaz/switch": "workspace:*",
		"@xmldom/xmldom": "0.9.12",
		"fflate": "0.8.3",
		"pdfjs-dist": "6.4.299",
		"postal-mime": "4.1.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "22.19.1",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"prettier": "3.9.10",
		"slophammer-ts": "0.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	}
}
