{
	"name": "@switch-examples/chess",
	"version": "0.1.0",
	"private": true,
	"description": "An example harness on switch: a decision model plays chess against a random opponent, Stockfish or itself.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --check .",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dry": "slophammer-ts dry .",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm coverage && pnpm dry"
	},
	"dependencies": {
		"@osolmaz/switch": "workspace:*",
		"@osolmaz/switch-viewer": "workspace:*",
		"chess.js": "1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "22.19.1",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"happy-dom": "21.0.1",
		"prettier": "3.9.10",
		"slophammer-ts": "0.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	}
}
